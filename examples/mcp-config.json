{
  "mcpServers": {
    "google-maps": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-google-maps"
      ],
      "env": {
        "GOOGLE_MAPS_API_KEY": "<YOUR_API_KEY>"
      }
    },
    "calculator": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-calculator"
      ],
      "env": {}
    }
  }
}